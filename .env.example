# ─────────────────────────────────────────────────────────────────────────────
# The Systems Connector — environment configuration
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED to enable the editor (/edit). Choose a long, unique passphrase.
EDIT_PASSWORD=change-me-to-a-long-passphrase

# REQUIRED in production: random secret used to sign login cookies (32+ chars).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# OPTIONAL: when set, viewers must enter this password before seeing the portfolio.
# Leave empty for unlisted (link-only) access.
VIEW_PASSWORD=

# OPTIONAL: persistent content storage (Upstash Redis / Vercel KV).
# Add the "Upstash for Redis" integration in the Vercel Marketplace and these are
# injected automatically. Either naming scheme is supported.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL: image uploads (Vercel Blob). Without it you can still paste image URLs.
BLOB_READ_WRITE_TOKEN=
